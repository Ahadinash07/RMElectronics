# ---------------------------------------------------------------------------
# RM Electronics - environment variables
# Copy this file to .env.local and fill in the values.  NEVER commit real
# secrets.  Only variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
# Final production origin, no trailing slash. Used for canonical URLs,
# sitemap, robots and Open Graph. Falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Lead delivery (SERVER ONLY - do not prefix with NEXT_PUBLIC_) -----------
# Choose one provider: "resend" (email) or "webhook" (CRM / Google Sheet / Zapier / Make).
# If this is empty or its credentials are missing, the enquiry endpoint answers
# with an honest error and the customer is shown the phone number instead.
LEAD_DELIVERY_PROVIDER=resend

# Provider: resend
RESEND_API_KEY=
# Where leads are delivered (the business inbox).
LEAD_TO_EMAIL=
# Sender. Use an address on a domain you verified in Resend. The shared test
# sender (onboarding@resend.dev) only delivers to your own Resend account email.
LEAD_FROM_EMAIL=

# Provider: webhook (alternative)
LEAD_WEBHOOK_URL=
# Optional shared secret sent as "Authorization: Bearer <secret>"
LEAD_WEBHOOK_SECRET=

# --- WhatsApp (only enable after the owner confirms the number is on WhatsApp)
# Leave "false" until verified. When "true", WhatsApp buttons appear.
NEXT_PUBLIC_WHATSAPP_VERIFIED=false

# --- Analytics / ads (all optional; nothing loads when empty) ----------------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Ads conversion tracking (both are needed for the lead conversion)
# ID like AW-XXXXXXXXX and the conversion label from the Ads conversion action.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
# Meta (Facebook) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
# "true" (default) = tracking scripts load only after the visitor accepts the
# consent banner. Set to "false" only if you have confirmed that is lawful for
# your audience and deployment.
NEXT_PUBLIC_ANALYTICS_REQUIRE_CONSENT=true

# --- Google reviews link (optional) -------------------------------------------
# Your Google Business Profile "Get more reviews" / write-a-review link (https).
# When set, a "Review us on Google" button appears. Leave empty until the profile exists.
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=
